generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  TEACHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
}

model User {
  id           String   @id @default(uuid())
  tuptId       String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjectStudents SubjectStudent[]
  quizAttempts    QuizAttempt[]
  ownedSubjects   Subject[]

  @@map("users")
}

enum SubjectVisibility {
  PUBLIC
  PRIVATE
}

enum StudentStatus {
  ONGOING
  FINISHED
}

model Subject {
  id          String            @id @default(uuid())
  ownerId     String?
  code        String?           @unique // NULL when PUBLIC, required when PRIVATE (CHECK in migration)
  title       String
  description String
  mediaUrl    String            // direct video file URL
  visibility  SubjectVisibility @default(PUBLIC)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  chapters Chapter[]
  students SubjectStudent[]
  owner    User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@map("subjects")
}

model Chapter {
  id              String   @id @default(uuid())
  subjectId       String
  chapterId       String   // "chapter-01"
  chapterNo       Int
  cardImage       String
  title           String
  description     String
  durationMinutes Int
  videoUrl        String
  slideUrl        String
  objectives      Json
  sections        Json
  keyTerms        Json
  references      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quiz    Quiz?

  @@unique([subjectId, chapterId])
  @@unique([subjectId, chapterNo])
  @@index([subjectId])
  @@map("chapters")
}

model SubjectStudent {
  id         String        @id @default(uuid())
  subjectId  String
  userId     String
  status     StudentStatus @default(ONGOING)
  joinedAt   DateTime      @default(now())
  finishedAt DateTime?

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subjectId, userId])
  @@index([userId])
  @@map("subject_students")
}

model Quiz {
  id        String   @id @default(uuid())
  chapterId String   @unique // strictly one quiz per chapter
  questions Json     // [{ questionNo, type, question, choices, correctAnswer }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter  Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id        String   @id @default(uuid())
  quizId    String
  userId    String
  score     Int
  total     Int
  answers   Json     // [{ questionNo, answer }]
  createdAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId]) // one attempt per quiz
  @@index([userId])
  @@map("quiz_attempts")
}