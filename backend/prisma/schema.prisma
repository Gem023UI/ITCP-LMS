generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum Role {
  STUDENT
  ADMIN
  TEACHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
}

enum SubjectVisibility {
  PUBLIC
  PRIVATE
}

enum StudentStatus {
  ONGOING
  FINISHED
}

enum DeadlineMode {
  STRICT // no submissions after the deadline
  LATE // submissions after the deadline are accepted and flagged late
}

// ───────────── Users ─────────────

model User {
  id           String     @id @default(uuid())
  tuptId       String?    @unique // TUPT-XX-XXXX; null for ADMIN (CHECK in migration)
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  imageUrl     String?
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) // date joined
  updatedAt    DateTime   @updatedAt

  student      Student?
  teacher      Teacher?
  articles     Article[]
  articleLikes ArticleLike[]

  @@map("users")
}

// Shared primary key: students.userId = users.id (strict 1:1). ADMIN has no extra table.
model Student {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjects        SubjectStudent[]
  quizAttempts    QuizAttempt[]
  chapterProgress ChapterProgress[]
  studyActivity   StudyActivity[]

  @@map("students")
}

model Teacher {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjects Subject[]

  @@map("teachers")
}

// ───────────── Subjects / Chapters / Quizzes ─────────────

model Subject {
  id          String            @id @default(uuid())
  teacherId   String
  code        String?           @unique // NULL when PUBLIC, required when PRIVATE (CHECK in migration)
  title       String
  description String
  mediaUrl    String // direct video URL or YouTube embed link
  visibility  SubjectVisibility @default(PUBLIC)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  teacher  Teacher          @relation(fields: [teacherId], references: [userId], onDelete: Restrict)
  chapters Chapter[]
  students SubjectStudent[]

  @@index([teacherId])
  @@map("subjects")
}

model Chapter {
  id              String   @id @default(uuid())
  subjectId       String
  chapterNo       Int
  cardImage       String
  title           String
  description     String
  durationMinutes Int
  videoUrl        String
  slideUrl        String
  objectives      Json
  sections        Json
  keyTerms        Json
  references      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subject  Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quiz     Quiz? // one chapter -> one quiz (with many questions inside)
  progress ChapterProgress[]

  @@unique([subjectId, chapterNo])
  @@index([subjectId])
  @@map("chapters")
}

model Quiz {
  id           String       @id @default(uuid())
  chapterId    String       @unique // strictly one quiz per chapter
  questions    Json // [{ questionNo, type, question, choices, correctAnswer }]
  deadline     DateTime? // null = no deadline
  deadlineMode DeadlineMode @default(STRICT) // ignored when deadline is null
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  chapter  Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id        String   @id @default(uuid())
  quizId    String
  studentId String
  score     Int
  total     Int
  answers   Json // [{ questionNo, answer }]
  isLate    Boolean  @default(false) // true when submitted after deadline in LATE mode
  createdAt DateTime @default(now())

  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([quizId, studentId]) // one attempt per quiz
  @@index([studentId])
  @@map("quiz_attempts")
}

// ───────────── Student-only data ─────────────

model SubjectStudent {
  id         String        @id @default(uuid())
  subjectId  String
  studentId  String
  status     StudentStatus @default(ONGOING)
  progress   Int           @default(0)
  joinedAt   DateTime      @default(now())
  finishedAt DateTime?

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([subjectId, studentId])
  @@index([studentId])
  @@map("subject_students")
}

model ChapterProgress {
  id        String   @id @default(uuid())
  studentId String
  chapterId String
  percent   Int      @default(0)
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([studentId, chapterId])
  @@index([chapterId])
  @@map("chapter_progress")
}

model StudyActivity {
  id        String   @id @default(uuid())
  studentId String
  date      DateTime @db.Date
  count     Int      @default(1)

  student Student @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([studentId, date])
  @@map("study_activity")
}

// ───────────── Articles ─────────────

// Authors must be TEACHER or STUDENT (enforced in the service layer; ADMIN cannot publish).
model Article {
  id            String   @id @default(uuid())
  authorId      String
  title         String
  coverImageUrl String
  sections      Json // [{ header, imageUrl, content }]
  likesCount    Int      @default(0) // cached; source of truth is article_likes (CHECK >= 0 in migration)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  ArticleLike[]

  @@index([authorId])
  @@index([createdAt])
  @@index([likesCount])
  @@map("articles")
}

model ArticleLike {
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId]) // one like per user per article
  @@index([userId])
  @@map("article_likes")
}
